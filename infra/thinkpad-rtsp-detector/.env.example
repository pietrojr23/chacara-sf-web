PORT=5060
CAMERA_NAME=cam1
LOG_LEVEL=INFO

# Modo recomendado: usa so o substream e salva apenas deteccoes relevantes.
SIMPLE_DETECTION_MODE=true
SUBSTREAM_ONLY=true

# Stream principal do detector: use o substream.
RTSP_URL=rtsp://USUARIO:SENHA@IP_DA_CAMERA:554/stream2
RTSP_TRANSPORT=tcp

# Opcional. So usado se SIMPLE_DETECTION_MODE=false.
VERIFY_RTSP_URL=

# Opcional. Se quiser compartilhar a pasta de imagens com outra instancia.
EVENT_IMAGES_DIR=

# Modelo leve para CPU antiga.
MODEL_PATH=yolo11n.pt
VERIFY_MODEL_PATH=yolo11s.pt

MIN_CONF=0.35
DEFAULT_ALLOWED_MIN_CONF=0.60
MIN_BBOX_AREA_RATIO=0.012
ANNOTATE_SAVED_IMAGES=true
SEMANTIC_FILTERS_ENABLED=false
PERSON_MIN_CONF=0.50
PERSON_MIN_AREA_RATIO=0.006
PERSON_MIN_ASPECT_RATIO=0.20
PERSON_MAX_ASPECT_RATIO=0.95
PERSON_MIN_BOTTOM_RATIO=0.30
PERSON_KEEP_WITHOUT_VERIFY_CONF=0.62
PERSON_KEEP_WITHOUT_VERIFY_AREA_RATIO=0.010
PERSON_KEEP_WITHOUT_VERIFY_BOTTOM_RATIO=0.38
BIRD_MIN_CONF=0.40
BIRD_TO_CAT_AREA_RATIO=0.007
BIRD_TO_CAT_MIN_ASPECT_RATIO=0.80
BIRD_TO_CAT_MIN_BOTTOM_RATIO=0.30
VERIFY_MIN_CONF=0.40
TARGET_LABELS=person,car,motorcycle,bus,truck,dog,cat,horse,sheep,cow
PERSON_SAVE_MIN_CONF=0.50
CAR_SAVE_MIN_CONF=0.55
MOTORCYCLE_SAVE_MIN_CONF=0.55
BUS_SAVE_MIN_CONF=0.55
TRUCK_SAVE_MIN_CONF=0.55
DOG_SAVE_MIN_CONF=0.60
CAT_SAVE_MIN_CONF=0.60
HORSE_SAVE_MIN_CONF=0.60
SHEEP_SAVE_MIN_CONF=0.60
COW_SAVE_MIN_CONF=0.60
PRIMARY_IMGSZ=640
VERIFY_IMGSZ=960
DETECT_INTERVAL_S=1.5
SAVE_ALL_DETECTIONS=true
SNAPSHOT_INTERVAL_S=0.0
SAVE_BEST_ONLY=false
BEST_EVENT_GAP_S=2.0
BEST_EVENT_MAX_HOLD_S=20.0
BEST_REPLACE_SCORE_DELTA=0.02
MOTION_DIFF_THRESHOLD=25
EVENT_COOLDOWN_S=15
MOTION_MIN_RATIO=0.03
MAX_INFER_WIDTH=640
RECONNECT_DELAY_S=5
JPEG_QUALITY=80
VERIFY_FRAME_SKIP=3
VERIFY_REQUIRED=false
SAVE_PRIMARY_ON_VERIFY_MISS=true
REQUIRE_VERIFY_FOR_PERSON=false

# Opcional
API_KEY=
