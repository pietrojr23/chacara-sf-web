# Porta HTTP do bridge
PORT=8787

# Chave para proteger os webhooks (usar no app: ?k=...)
BRIDGE_API_KEY=troque-por-uma-chave-forte

# Tuya Cloud
# Exemplos de base URL (escolha o data center correto do seu projeto Tuya):
# https://openapi.tuyaus.com
# https://openapi.tuyacn.com
# https://openapi.tuyaeu.com
# https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaus.com
# Opcional: lista adicional de data centers para fallback automático (separados por vírgula)
# TUYA_BASE_URLS=https://openapi-ueaz.tuyaus.com,https://openapi.tuyaeu.com
TUYA_ACCESS_KEY=
TUYA_SECRET_KEY=
TUYA_DEVICE_ID=

# Modo recomendado para central PPA via contato seco: pulso único
SINGLE_BUTTON_MODE=true
PULSE_MS=700

# Comando padrão (MS-111 normalmente usa switch_1)
OPEN_COMMAND_CODE=switch_1
OPEN_ON_VALUE=true
OPEN_OFF_VALUE=false

# Se SINGLE_BUTTON_MODE=false, usa estes para fechar
CLOSE_COMMAND_CODE=switch_1
CLOSE_ON_VALUE=true
CLOSE_OFF_VALUE=false

# Faróis (modo interruptor: mantém estado ligado/desligado)
HEADLIGHTS_COMMAND_CODE=switch_1
HEADLIGHTS_ON_VALUE=true
HEADLIGHTS_OFF_VALUE=false
